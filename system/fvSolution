FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        tolerance       1e-6;
        relTol          0.01;
        smoother        DICGaussSeidel;
    }

    pFinal
    {
        $p;
        tolerance       1e-06;
        relTol          0.01;
    }

    "(U|k|epsilon|omega|R|nuTilda).*"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        tolerance       1e-06;
        relTol          0.1;
    }
}


PIMPLE
{
    nCorrectors     2;
    nNonOrthogonalCorrectors 2;
    //pRefCell        0;
   // pRefValue       0;
    momentumPredictor no;
    nOuterCorrectors 2;
}

relaxationFactors
{
    equations
    {
       ".*"     1.0;
    }
}
