FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [kinematicViscosity]; //Cambiar turbulentViscosity por kinematicViscosity

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }

    outlet
    {
        type            calculated;
        value           uniform 0;
    }

    cubo
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    upbot
    {
        type            calculated;
        value           uniform 0;
    }
    front
    {
        type            empty;
    }

    back
    {
        type            empty;
    }
}
