FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [velocity];

internalField   uniform (25 0 0);

boundaryField
{
    inlet
    {
        type  fixedValue;
        value $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           $internalField;
    }
    cubo
    {
        type            noSlip;
    }
    upbot
    {
        type slip;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
}

